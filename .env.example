# Copy to .env and fill in from Supabase: Project Settings > API Keys (and Data API for the URL)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY
# Never put the secret key (sb_secret_...) here: it would end up inside the app for anyone to read.
